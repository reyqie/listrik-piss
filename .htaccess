RewriteEngine On
RewriteBase /listrik-piss/

# Redirect .php ke tanpa extension (GET saja)
RewriteCond %{REQUEST_METHOD} GET
# RewriteCond %{THE_REQUEST} \s/+listrik-piss/(.+)\.php[\s?]
# RewriteRule ^ %1 [R=301,L]

# Mapping tanpa extension → file .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
